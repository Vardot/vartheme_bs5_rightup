{#
/**
 * @file
 * Template for the system menu block.
 */
#}
{# The nav landmark is named by its block label; an empty label sets no name. #}
{% if configuration.label is not empty %}
  {% set attributes = attributes.setAttribute('aria-label', configuration.label) %}
{% endif %}
{% include 'vartheme_bs5_rightup:block' with {
  html_tag: 'nav'
} %}
