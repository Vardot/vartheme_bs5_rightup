{#
/**
 * @file
 * Where to listen to the current episode: its own links, or its podcast's.
 */
#}
{% set episode = row._entity %}
{% set source = episode.hasField('field_listen_links') and episode.field_listen_links is not empty ? episode : row._relationship_entities.field_podcast %}
{% set links = [] %}
{% if source %}
  {% for item in source.field_listen_links %}
    {% set links = links|merge([{ title: item.title, url: item.getUrl().toString() }]) %}
  {% endfor %}
{% endif %}
{{ include('vartheme_bs5_rightup:podcast-platforms', { links: links }, false) }}
