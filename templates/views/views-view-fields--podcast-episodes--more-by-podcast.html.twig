{#
/**
 * @file
 * One episode in the "More Episodes" rail of an episode page.
 */
#}
{% set host = fields.field_host.content|striptags|trim %}
{% set number = fields.field_episode_number.content|striptags|trim %}
{% set url = fields.view_node.content|striptags|trim %}
{% set last = row.index == view.result|length - 1 %}
<article class="d-flex flex-column gap-2 {{ last ? 'mb-4' : 'pb-4 mb-4 border-bottom border-black' }}">
  {% if number %}
    {{ include('vartheme_bs5_rightup:taxonomy', { label: 'Episode @n'|t({'@n': number}) ~ '', size: 'taxonomy-lg', color: 'text-tertiary', no_padding: true, justify_content: 'justify-content-start' }, false) }}
  {% endif %}
  {{ include('vartheme_bs5_rightup:heading', { heading_text: row_title|default(row._entity.label), level: 3, text_size: 'h5', url: url, attributes: create_attribute({ class: ['mb-0'] }) }, false) }}
  {% if host %}<p class="font-serif text-body-secondary small mt-2 mb-0">{{ 'Hosted by @host'|t({'@host': host}) }}</p>{% endif %}
</article>
