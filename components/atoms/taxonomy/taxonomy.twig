{#
/**
 * @file
 * Vartheme BS5 Rightup Starter Kit implementation for the Taxonomy component.
 *
 * Taxonomy badge rendered with Bootstrap utilities plus the component's own
 * size modifiers (see taxonomy.scss). Renders as a link when a URL is
 * provided, otherwise as a span.
 *
 * Available properties:
 * - label: Text shown inside the taxonomy badge. (required)
 * - url: If provided, taxonomy will render as a link. Defaults to ``.
 * - target: Where to open the link (only used when Link is provided).
 *           (_self | _blank) Defaults to `_self`.
 * - size: Controls the typography size (taxonomy modifier class).
 *         (taxonomy-lg | taxonomy-sm) Defaults to `taxonomy-lg`.
 * - color: Bootstrap text color utility for the badge label.
 *          (text-tertiary | text-accent | text-primary | text-secondary
 *           | text-success | text-danger | text-warning | text-info
 *           | text-dark | text-white | text-muted) Defaults to
 *          `text-tertiary`.
 * - no_padding: Removes the badge's padding for a flush, zero-padding
 *               taxonomy label. Defaults to `false`.
 * - justify_content: Controls the horizontal alignment of the badge content
 *                     (justify-content-start | justify-content-center |
 *                     justify-content-end) Defaults to
 *                     `justify-content-center`.
 *
 * Available attributes:
 * - attributes: Attributes array.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set url = url|default('') %}
{% set target = target|default('_self') %}
{% set size = size|default('taxonomy-lg') %}
{% set color = color|default('text-tertiary') %}
{% set justify_content = justify_content|default('justify-content-center') %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set no_padding = no_padding ?? false %}

{# Logic: the size prop is itself the modifier class (see taxonomy.scss). #}
{% set size_classes = [size] %}

{# Logic: p-0 overrides the badge's built-in padding when requested. #}
{% set padding_classes = no_padding ? ['p-0'] : [] %}

{# Logic: base visual styling — Bootstrap utilities plus the component's own
 # size modifiers (Bootstrap's fs-* scale doesn't land on the exact sizes
 # needed here). No background or border — colored text only. #}
{% set base_classes = [
  'taxonomy',
  'badge',
  'd-inline-flex',
  'align-items-center',
  justify_content,
  'text-nowrap',
  'fw-bold',
  'text-uppercase',
  color,
]|merge(size_classes)|merge(padding_classes) %}

{% set has_url = url is not empty %}

{# Print the HTML. #}
{% if has_url %}
  {% set taxonomy_link_classes = base_classes|merge(['text-decoration-none']) %}
  {% set attributes = attributes.addClass(taxonomy_link_classes) %}
  <a
    href="{{ url|e }}"
    {{ attributes }}
    {% if target == '_blank' %}
      target="_blank" rel="noopener noreferrer"
    {% endif %}
  >
    {{ label|e }}
  </a>
{% else %}
  {% set attributes = attributes.addClass(base_classes) %}
  <span{{ attributes }}>
    {{ label|e }}
  </span>
{% endif %}
