---
{% stories Taxonomy with {
  title: 'Base/Taxonomy',
  parameters: {
    componentSubtitle: 'Taxonomy badge',
    docs: {
      description: {
        component: 'Taxonomy component that can render as plain text or a link. Bold, uppercase, colored text with no background or border.',
      },
      story: {inline: true},
    },
  },
  argTypes: {
    label: {
      name: 'Label',
      description: 'Text shown inside the taxonomy badge.',
      defaultValue: 'Taxonomy',
      control: 'text',
    },
    url: {
      name: 'Link (optional)',
      description: 'If provided, taxonomy will render as a link.',
      defaultValue: '',
      control: 'text',
    },
    target: {
      name: 'Link target',
      description: 'Where to open the link (only used when Link is provided).',
      defaultValue: '_self',
      control: 'select',
      options: {
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
    size: {
      name: 'Size',
      description: 'Typography size (taxonomy modifier class).',
      defaultValue: 'taxonomy-lg',
      control: 'select',
      options: {
        Large: 'taxonomy-lg',
        Small: 'taxonomy-sm',
      },
    },
    color: {
      name: 'Color',
      description: 'Bootstrap text color utility for the badge label.',
      defaultValue: 'text-tertiary',
      control: 'select',
      options: {
        'Tertiary (default)': 'text-tertiary',
        Accent: 'text-accent',
        Primary: 'text-primary',
        Secondary: 'text-secondary',
        Success: 'text-success',
        Danger: 'text-danger',
        Warning: 'text-warning',
        Info: 'text-info',
        Dark: 'text-dark',
        White: 'text-white',
        Muted: 'text-muted',
      },
    },
    no_padding: {
      name: 'Remove padding',
      description: "Removes the badge's padding for a flush, zero-padding taxonomy label.",
      defaultValue: false,
      control: 'boolean',
    },
    justify_content: {
      name: 'Horizontal alignment',
      description: 'Controls the horizontal alignment of the badge content (justify-content modifier class).',
      defaultValue: 'justify-content-center',
      control: 'select',
      options: {
        Left: 'justify-content-start',
        Center: 'justify-content-center',
        Right: 'justify-content-end',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default (Large)',
  args: {
    label: 'Taxonomy',
    url: '',
    target: '_self',
    size: 'taxonomy-lg',
    color: 'text-tertiary',
    no_padding: false,
    justify_content: 'justify-content-center',
  },
} %}
{{ include('vartheme_bs5_rightup:taxonomy') }}
{% endstory %}

{% story Small with {
  name: 'Small',
  args: {
    label: 'Small taxonomy',
    size: 'taxonomy-sm',
  },
} %}
{{ include('vartheme_bs5_rightup:taxonomy') }}
{% endstory %}

{% story WithLink with {
  name: 'With link',
  args: {
    label: 'Linked taxonomy',
    url: 'https://example.com',
    target: '_blank',
    size: 'taxonomy-lg',
  },
} %}
{{ include('vartheme_bs5_rightup:taxonomy') }}
{% endstory %}

{% story AccentColor with {
  name: 'Accent color',
  args: {
    label: 'Featured',
    color: 'text-accent',
    size: 'taxonomy-lg',
  },
} %}
{{ include('vartheme_bs5_rightup:taxonomy') }}
{% endstory %}

{% endstories %}
