{% stories HorizontalTextIconCard with {
  title: 'Card/Horizontal Text Icon Card',
  parameters: {
    componentSubtitle: 'Flexible content slot with a fixed circular play icon',
    docs: {
      description: {
        component: 'Full-width horizontal card with a flexible content slot and a fixed circular play icon in one of two brand colors. The heading in the slot underlines on hover.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    icon_color: {
      name: 'Icon color',
      description: 'Bootstrap theme color for the circular icon background.',
      defaultValue: 'bg-tertiary',
      control: 'select',
      options: {
        Blue: 'bg-tertiary',
        "'Accent (Mint)'": 'bg-accent',
      },
    },
    background_color: {
      name: 'Background color',
      description: 'Brand background color applied to the card.',
      defaultValue: 'bg-primary',
      control: 'select',
      options: {
        None: 'none',
        "'Body tertiary'": 'bg-body-tertiary',
        Tertiary: 'bg-tertiary',
        Accent: 'bg-accent',
        Primary: 'bg-primary',
        "'Primary subtle'": 'bg-primary-subtle',
        Secondary: 'bg-secondary',
        "'Secondary subtle'": 'bg-secondary-subtle',
        Dark: 'bg-dark',
      },
    },
    corner_style: {
      name: 'Border radius',
      description: 'Bootstrap rounded utility applied to the card.',
      defaultValue: 'rounded-0',
      control: 'select',
      options: {
        "'None (square)'": 'rounded-0',
        Small: 'rounded-1',
        Medium: 'rounded-2',
        Large: 'rounded-3',
        "'Extra Large'": 'rounded-4',
        "'Extra Extra Large'": 'rounded-5',
        Pill: 'rounded-pill',
      },
    },
    padded: {
      name: 'Padded',
      description: 'Adds Bootstrap padding (p-4) to the card.',
      defaultValue: true,
      control: 'boolean',
    },
    content_vertical_alignment: {
      name: 'Content vertical alignment',
      description: 'Vertical alignment of the content slot and icon within the row.',
      defaultValue: 'align-items-center',
      control: 'select',
      options: {
        Top: 'align-items-start',
        Center: 'align-items-center',
        Bottom: 'align-items-end',
      },
    },
    stretched_link: {
      name: 'Stretched link',
      description: 'When enabled and a Card link URL is provided, the entire card becomes clickable.',
      defaultValue: false,
      control: 'boolean',
    },
    link_url: {
      name: 'Card link URL',
      description: 'Optional URL for the card link. Only used when Stretched link is enabled.',
      defaultValue: '',
      control: 'text',
    },
    link_target: {
      name: 'Link target',
      description: 'Where to open the card link.',
      defaultValue: '_self',
      control: 'select',
      options: {
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
  },
} %}

{% story Default with {
  name: 'Blue icon',
  args: {
    icon_color: 'bg-tertiary',
    background_color: 'bg-primary',
    corner_style: 'rounded-0',
    padded: true,
    content_vertical_alignment: 'align-items-center',
    stretched_link: false,
    link_url: '',
    link_target: '_self',
  },
} %}
{% embed 'vartheme_bs5_rightup:horizontal-text-icon-card' with {
  icon_color: icon_color,
  background_color: background_color,
  corner_style: corner_style,
  padded: padded,
  content_vertical_alignment: content_vertical_alignment,
  stretched_link: stretched_link,
  link_url: link_url,
  link_target: link_target,
} only %}
  {% block content %}
    <span class="text-uppercase fw-bold text-accent small">Episode 13</span>
    <h3>No Straight Walls</h3>
    <p>An architect on designing a museum wing with no straight walls, and why the client said yes.</p>
    <p class="mb-0">Hosted by Noor Fasi &middot; 37 Mins</p>
  {% endblock %}
{% endembed %}
{% endstory %}

