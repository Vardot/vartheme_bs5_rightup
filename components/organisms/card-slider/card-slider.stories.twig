{# Card content here is plain placeholder markup with light text — a real
 # dark-section card would come from a card component styled/propped for
 # light text; title_color/divider_color only style the slider's own
 # header, not whatever component is dropped into the cards slot. #}
<div class="bg-black p-4">
{% embed 'vartheme_bs5_rightup:card-slider' with _context %}
  {% block cards %}
    <div class="text-white">
      <div class="ratio ratio-4x3 bg-secondary mb-3"></div>
      <p class="text-primary fw-bold text-uppercase small mb-2">Culture</p>
      <h3 class="h5">A Photographer's 10-Year Study of Ceremony and Color in West Africa</h3>
      <p class="mb-0 text-white-50">By Sana Kovač</p>
    </div>
    <div class="text-white">
      <div class="ratio ratio-4x3 bg-secondary mb-3"></div>
      <p class="text-primary fw-bold text-uppercase small mb-2">Process</p>
      <h3 class="h5">What Fen &amp; Marble Actually Use to Pitch New Clients</h3>
      <p class="mb-0 text-white-50">By Tom James</p>
    </div>
    <div class="text-white">
      <div class="ratio ratio-4x3 bg-secondary mb-3"></div>
      <p class="text-primary fw-bold text-uppercase small mb-2">Architecture</p>
      <h3 class="h5">A Facade System Built Entirely From Salvaged Material</h3>
      <p class="mb-0 text-white-50">By Rena Osei</p>
    </div>
  {% endblock %}
{% endembed %}
</div>
{% endstory %}
