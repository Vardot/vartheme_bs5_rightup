{#
/**
 * @file
 * Vartheme BS5 Rightup Starter Kit implementation for the Card Slider component.
 *
 * Horizontally scrollable slider for showing multiple card components (e.g.
 * Article Teaser) side by side. Uses slot content for the cards so Canvas
 * can manage drag/drop ordering and avoids pre-building a card array in
 * Twig — any card-shaped component works, the slider only lays out and
 * scrolls its direct children.
 *
 * Available properties:
 * - label: Small heading shown above the cards (e.g. "On display"). Leave
 *          empty to omit it. Defaults to `''`.
 * - title_color: Text color utility for the label. Use text-white on a
 *                black/dark background section. (text-dark | text-body
 *                | text-white | text-muted) Defaults to `text-dark`.
 * - divider_color: Bootstrap border color utility for the horizontal line.
 *                  Use border-white on a black/dark background section.
 *                  (border-primary | border-primary-subtle | border-secondary
 *                   | border-secondary-subtle | border-success
 *                   | border-success-subtle | border-danger
 *                   | border-danger-subtle | border-warning
 *                   | border-warning-subtle | border-info | border-info-subtle
 *                   | border-light | border-dark | border-dark-subtle
 *                   | border-black | border-white) Defaults to `border-primary`.
 * - show_controls: (true|false) Show previous/next controls. Defaults to
 *                  `true`.
 * - control_bg_color: Theme color for the previous/next icon box background.
 *                     (accent | tertiary | primary | secondary | success
 *                      | danger | warning | info | light | dark | white
 *                      | black) Defaults to `accent`.
 * - control_icon_color: Theme color for the previous/next chevron icon.
 *                       (white | black | dark | light | accent | tertiary
 *                        | primary | secondary | success | danger | warning
 *                        | info) Defaults to `white`.
 * - control_disabled_opacity: Opacity of the icon box when its direction has
 *                             no more cards to scroll to. (opacity-0
 *                             | opacity-25 | opacity-50 | opacity-75
 *                             | opacity-100) Defaults to `opacity-50`.
 * - visible_items: How many cards are visible at once on desktop (md,
 *                  768px, and up). Narrow viewports show fewer — 2 (or
 *                  fewer) from sm (576px) up to md, 1 below that.
 *                  (1 | 2 | 3 | 4) Defaults to `3`.
 *
 * Available attributes:
 * - attributes: the outermost <section> element.
 * - track_attributes: the scrollable track wrapping the cards slot content.
 *
 * Available slots:
 * - cards: Add two or more card components here (e.g. Article Teaser).
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set slider_id = id|default('')|trim %}
{% if slider_id is empty %}
  {% set slider_id = 'card-slider-' ~ random(1000000) %}
{% endif %}
{% set label = label|default('') %}
{% set title_color = title_color|default('text-dark') %}
{% set divider_color = divider_color|default('border-primary') %}
{% set control_bg_color = control_bg_color|default('accent') %}
{% set control_icon_color = control_icon_color|default('white') %}
{% set control_disabled_opacity = control_disabled_opacity|default('opacity-50') %}
{% set visible_items = (visible_items|default('3'))|trim %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set show_controls = show_controls ?? true %}

{# Logic: label / header presence. The header row (label, divider, controls)
 # is only rendered when there is something to put in it.
 #}
{% set has_label = label|trim is not empty %}
{% set has_header = has_label or show_controls %}

{# Logic: slot content. Slots arrive as pre-rendered Twig variables (see
 # organisms/hero-slider-container for the same pattern with its "slides"
 # slot), so an emptiness check is a render + trim rather than a {% block %}
 # check. #}
{% set has_cards = cards is defined and cards|render|trim is not empty %}

{# Logic: class arrays merged as arrays. #}
{% set section_classes = ['card-slider'] %}
{% set header_classes = ['card-slider__header', 'd-flex', 'align-items-center', 'mb-4'] %}
{% set label_classes = ['card-slider__label', 'fw-bold', 'text-uppercase', 'mb-0', 'flex-shrink-0', title_color] %}
{% set divider_classes = ['card-slider__divider', 'flex-grow-1', 'border-top', divider_color, 'ms-1', 'me-3'] %}
{% set controls_classes = ['card-slider__controls', 'd-flex', 'align-items-center', 'gap-2', 'flex-shrink-0'] %}
{% set control_classes = [
  'card-slider__control',
  'card-slider__control--bg-' ~ control_bg_color,
  'card-slider__control--icon-' ~ control_icon_color,
  'card-slider__control--' ~ control_disabled_opacity,
] %}
{% set track_classes = ['card-slider__track', 'card-slider__track--visible-' ~ visible_items, 'gap-4'] %}

{# Logic: attributes. #}
{% set attributes = attributes.addClass(section_classes).setAttribute('id', slider_id) %}

{% if not track_attributes %}
  {% set track_attributes = create_attribute() %}
{% endif %}
{% set track_attributes = track_attributes
  .addClass(track_classes)
  .setAttribute('tabindex', '0')
  .setAttribute('aria-label', has_label ? label : 'Card slider'|t)
  .setAttribute('data-card-slider-track', true)
%}

{% if not header_attributes %}
  {% set header_attributes = create_attribute() %}
{% endif %}
{% set header_attributes = header_attributes.addClass(header_classes) %}

{% set label_attributes = create_attribute().addClass(label_classes) %}
{% set divider_attributes = create_attribute().addClass(divider_classes) %}
{% set controls_attributes = create_attribute().addClass(controls_classes) %}
{% set prev_attributes = create_attribute()
  .addClass(control_classes)
  .setAttribute('data-card-slider-prev', true)
  .setAttribute('aria-controls', slider_id)
%}
{% set next_attributes = create_attribute()
  .addClass(control_classes)
  .setAttribute('data-card-slider-next', true)
  .setAttribute('aria-controls', slider_id)
%}

{# Print the HTML. #}
<section{{ attributes }}>
  {% if has_header %}
    <div{{ header_attributes }}>
      {% if has_label %}
        <h2{{ label_attributes }}>{{ label }}</h2>
      {% endif %}

      <div{{ divider_attributes }} aria-hidden="true"></div>

      {% if show_controls %}
        <div{{ controls_attributes }}>
          {{ include('vartheme_bs5_rightup:button', {
            label: 'Previous'|t,
            label_attributes: create_attribute().addClass(['visually-hidden']),
            variant: 'btn-primary',
            size: 'btn-md',
            radius: 'rounded-2',
            icon: 'chevron-left',
            attributes: prev_attributes,
          }, with_context: false) }}

          {{ include('vartheme_bs5_rightup:button', {
            label: 'Next'|t,
            label_attributes: create_attribute().addClass(['visually-hidden']),
            variant: 'btn-primary',
            size: 'btn-md',
            radius: 'rounded-2',
            icon: 'chevron-right',
            attributes: next_attributes,
          }, with_context: false) }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div{{ track_attributes }}>
    {% if has_cards %}
      {{ cards }}
    {% endif %}
  </div>
</section>
