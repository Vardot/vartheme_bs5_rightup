{% set demo_cover = {
  src: '/components/foundation/images/assets/teaser-2.jpg',
  alt: 'Last Call cover art',
  width: 800,
  height: 800,
} %}

{% stories PodcastCard with {
  title: 'Card/Podcast Card',
  parameters: {
    componentSubtitle: 'Podcast/show teaser card',
    docs: {
      description: {
        component: 'Cover image, a drag & drop content slot, a fixed meta text, and a "view show" button, with an optional stretched-link overlay.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    media_image: {
      name: 'Cover image',
      description: 'Upload the podcast/show cover image.',
      control: 'object',
    },
    content_padding: {
      name: 'Content padding',
      control: 'boolean',
      defaultValue: true,
    },
    meta_text: {
      name: 'Meta text',
      control: 'text',
      defaultValue: '38 Episodes',
    },
    image_ratio: {
      name: 'Image ratio (crop)',
      control: 'select',
      defaultValue: 'ratio-1x1',
      options: {
        'Auto (no crop)': 'ratio-auto',
        'Wide (16:9)': 'ratio-16x9',
        'Standard (4:3)': 'ratio-4x3',
        'Square (1:1)': 'ratio-1x1',
        'Ultra-wide (21:9)': 'ratio-21x9',
      },
    },
    image_fit: {
      name: 'Image fit',
      control: 'select',
      defaultValue: 'object-fit-cover',
      options: {
        'Fill (crop)': 'object-fit-cover',
        'Fit (no crop)': 'object-fit-contain',
      },
    },
    button_text: {
      name: 'Button text',
      control: 'text',
      defaultValue: 'View Show',
    },
    button_url: {
      name: 'Button URL',
      control: 'text',
      defaultValue: '/podcasts/last-call',
    },
    button_target: {
      name: 'Button target',
      control: 'select',
      defaultValue: '_self',
      options: {
        'Same tab': '_self',
        'New tab': '_blank',
      },
    },
    stretched_link: {
      name: 'Stretched link',
      control: 'boolean',
      defaultValue: false,
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    media_image: demo_cover,
    content_padding: true,
    meta_text: '38 Episodes',
    image_ratio: 'ratio-1x1',
    image_fit: 'object-fit-cover',
    button_text: 'View Show',
    button_url: '/podcasts/last-call',
    button_target: '_self',
    stretched_link: true,
  },
} %}
{% embed 'vartheme_bs5_rightup:podcast-card' with _context %}
  {% block content_slot %}
    <h3 class="h4 fw-bold mb-3">Last Call</h3>
    <p class="text-muted mb-0">The decisions nobody sees, told by the people who made them.</p>
  {% endblock %}
{% endembed %}
{% endstory %}

{% story NoContentPadding with {
  name: 'No Content Padding',
  args: {
    media_image: demo_cover,
    content_padding: false,
    meta_text: '12 Episodes',
    image_ratio: 'ratio-1x1',
    image_fit: 'object-fit-cover',
    button_text: 'View Show',
    button_url: '/podcasts/field-notes',
    button_target: '_self',
    stretched_link: false,
  },
} %}
{% embed 'vartheme_bs5_rightup:podcast-card' with _context %}
  {% block content_slot %}
    <div class="px-4 pt-4">
      <h3 class="h4 fw-bold mb-3">Field Notes</h3>
      <p class="text-muted mb-0">Conversations recorded on location, unscripted and unedited.</p>
    </div>
  {% endblock %}
{% endembed %}
{% endstory %}

{% story MetaOnly with {
  name: 'Meta Only',
  args: {
    media_image: demo_cover,
    content_padding: true,
    meta_text: '38 Episodes',
    image_ratio: 'ratio-1x1',
    image_fit: 'object-fit-cover',
    button_text: 'View Show',
    button_url: '',
    button_target: '_self',
    stretched_link: false,
  },
} %}
{% embed 'vartheme_bs5_rightup:podcast-card' with _context %}
  {% block content_slot %}
    <h3 class="h4 fw-bold mb-3">Night Shift</h3>
    <p class="text-muted mb-0">Stories from the people who keep the lights on after dark.</p>
  {% endblock %}
{% endembed %}
{% endstory %}

{% story EmptySlot with {
  name: 'Empty Slot',
  args: {
    media_image: demo_cover,
    content_padding: true,
    meta_text: '',
    image_ratio: 'ratio-1x1',
    image_fit: 'object-fit-cover',
    button_text: 'View Show',
    button_url: '',
    button_target: '_self',
    stretched_link: false,
  },
} %}
{% embed 'vartheme_bs5_rightup:podcast-card' with _context only %}
{% endembed %}
{% endstory %}
{% endstories %}
