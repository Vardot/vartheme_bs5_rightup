{#
/**
 * @file
 * Vartheme BS5 Rightup Starter Kit implementation for the Icon Toggle component.
 *
 * A single icon button, meant to sit at the end of the header/navbar (or
 * anywhere else). Clicking it reveals a popover panel holding whatever is
 * dropped into the "content" slot, overlaid over the page so sibling
 * elements (e.g. the main menu) stay visible the whole time; clicking it
 * again (now showing a close icon), pressing Escape, or clicking outside
 * closes the panel.
 *
 * Available properties:
 * - icon: Bootstrap Icon name shown in the closed state. Swaps to a close
 *         (X) icon while the panel is open. Defaults to `search`.
 * - label: Accessible label for the closed state (visually hidden).
 *          Defaults to `Search`.
 * - open_label: Accessible label announced while the panel is open.
 *               Defaults to `Close search`.
 * - icon_color: Bootstrap text color utility class used to control the
 *               icon's color. (text-body | text-primary | text-secondary
 *               | text-success | text-danger | text-warning | text-info
 *               | text-light | text-dark | text-white | text-muted
 *               | text-body-secondary | text-body-tertiary
 *               | text-primary-emphasis | text-secondary-emphasis
 *               | text-success-emphasis | text-danger-emphasis
 *               | text-warning-emphasis | text-info-emphasis)
 *               Defaults to `text-body`.
 * - panel_width: How wide the revealed panel is. `popover` anchors a narrow
 *                panel under the icon; `full` spans the viewport as a bar
 *                directly below the header. Defaults to `popover`.
 * - placement: Which side the popover panel aligns to. Ignored when
 *              panel_width is `full`. (end | start) Defaults to `end`.
 * - expand_in_editor: Force the popover open while previewed inside the
 *                      Drupal Canvas editor, so its "content" slot stays
 *                      reachable for dropping components in. Defaults to
 *                      `true`.
 *
 * Available attributes:
 * - attributes: HTML attributes for the root element.
 *
 * Available slots:
 * - content: The content revealed in the popover.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set icon = icon|default('search') %}
{% set label = label|default('Search'|t) %}
{% set open_label = open_label|default('Close search'|t) %}
{% set icon_color = icon_color|default('text-body') %}
{% set placement = placement|default('end') %}
{% set panel_width = panel_width|default('popover') %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set expand_in_editor = expand_in_editor ?? true %}

{# Logic: merge root classes as an array. #}
{% set classes = ['icon-toggle', 'icon-toggle--' ~ placement, 'icon-toggle--panel-' ~ panel_width]|merge(expand_in_editor ? [] : ['icon-toggle--collapsed-in-editor']) %}

{# Logic: static structural class lists and a unique panel id. #}
{% set button_classes = ['icon-toggle__button'] %}
{% set panel_classes = ['icon-toggle__panel'] %}
{% set panel_id = 'icon-toggle-panel-' ~ random(99999) %}

{# Slot content. Checked for emptiness (not just block-default) because
 # Canvas passes an empty string for an unfilled slot, which would otherwise
 # silently win over a default placeholder written inside the block. #}
{% set panel_content %}{% block content %}{% endblock %}{% endset %}
{% set has_content = panel_content|trim is not empty %}

{# Print the HTML. #}
{% set attributes = attributes.addClass(classes) %}
<div{{ attributes }}>
  <button type="button" class="{{ button_classes|join(' ') }}" aria-expanded="false" aria-controls="{{ panel_id }}" data-icon-toggle-open-label="{{ open_label }}" aria-label="{{ label }}">
    <span class="icon-toggle__icons" aria-hidden="true">
      {{ include('vartheme_bs5_rightup:bootstrap-icon', {
        icon: icon,
        icon_size: 'fs-5',
        color: icon_color,
        attributes: create_attribute().addClass(['icon-toggle__icon', 'icon-toggle__icon--closed']),
      }, with_context = false) }}
      {{ include('vartheme_bs5_rightup:bootstrap-icon', {
        icon: 'x-lg',
        icon_size: 'fs-5',
        color: icon_color,
        attributes: create_attribute().addClass(['icon-toggle__icon', 'icon-toggle__icon--open']),
      }, with_context = false) }}
    </span>
  </button>

  {# The design dims the page behind an open full-width search. A real
   # element rather than a pseudo-element, so it can be clicked to dismiss;
   # aria-hidden and tabindex -1 keep it out of the accessibility tree and
   # the tab order, since Escape and the toggle already close the panel. #}
  <button type="button" class="icon-toggle__scrim" aria-hidden="true" tabindex="-1"></button>

  <div class="{{ panel_classes|join(' ') }}" id="{{ panel_id }}" hidden>
    <div class="icon-toggle__panel-inner">
      {% if has_content %}
        {{ panel_content }}
      {% else %}
        <p class="icon-toggle__placeholder text-muted mb-0">{{ 'Drop content here.'|t }}</p>
      {% endif %}
    </div>
  </div>
</div>
