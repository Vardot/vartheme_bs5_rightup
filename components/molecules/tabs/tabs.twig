{#
/**
 * @file
 * Vartheme BS5 Rightup Starter Kit implementation for the Tabs component.
 *
 * Available properties:
 * - tabs_id: Unique id for the tabs container. Leave empty to auto-generate.
 * - shape: The shape of the tabs. (tabs | pills) Defaults to `tabs`.
 * - active_bg: Bootstrap theme color for the active tab's background.
 *              (default | black | secondary | primary | tertiary | accent
 *               | success | danger | warning | info | light | dark | white)
 *              Defaults to `default` (brand tertiary).
 * - active_color: Bootstrap theme color for the active tab's text.
 *                 (default | black | secondary | primary | tertiary | accent
 *                  | success | danger | warning | info | light | dark
 *                  | white) Defaults to `default` (white).
 * - border_color: Bootstrap border color utility for the shared bottom
 *                 border. (default | border-black | border-secondary
 *                  | border-primary | border-tertiary | border-accent
 *                  | border-success | border-danger | border-warning
 *                  | border-info | border-light | border-dark
 *                  | border-white) Defaults to `default` (neutral).
 *
 * Available attributes:
 * - attributes: HTML attributes for the containing element.
 * - content_attributes: HTML attributes for the tab-content (panes) wrapper.
 *
 * Available slots:
 * - items: One or more Tab Item components.
 * - panes: Optional. One or more Tab Pane components, paired with the Tab
 *          Items above via matching Pane ID.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set shape = shape|default('tabs') %}
{% set active_bg = active_bg|default('default') %}
{% set active_color = active_color|default('default') %}
{% set border_color = border_color|default('default') %}

{# Logic: resolve ID. #}
{% set resolved_tabs_id = tabs_id|default('')|trim %}
{% if resolved_tabs_id is empty %}
  {% set resolved_tabs_id = 'tabs-' ~ random(1000000) %}
{% endif %}

{# Logic: the active tab's background/text color are resolved here as
 # modifier classes on this (the only element Tabs itself renders) — tabs.scss
 # then targets any nested `.nav-link.active` (however the items slot was
 # composed) via a plain CSS descendant selector, so no context has to be
 # threaded down to the Tab Item components.
 #}
{% set active_bg_classes = active_bg != 'default' ? ['tabs--active-bg-' ~ active_bg] : [] %}
{% set active_color_classes = active_color != 'default' ? ['tabs--active-color-' ~ active_color] : [] %}
{% set border_color_classes = border_color != 'default' ? [border_color] : [] %}

{# Logic: merge the tab container classes as arrays. #}
{% set tabs_block_classes = ['tabs', 'nav', 'nav-' ~ shape]
  |merge(active_bg_classes)
  |merge(active_color_classes)
  |merge(border_color_classes)
%}

{# Logic: resolve state flags. #}
{% set has_slot_content = items is defined and items|render|trim is not empty %}
{% set has_panes_content = panes is defined and panes|render|trim is not empty %}

{# Logic: build attributes. #}
{% set attributes = attributes
  .addClass(tabs_block_classes)
  .setAttribute('id', resolved_tabs_id)
  .setAttribute('role', 'tablist')
%}

{% if not content_attributes %}
  {% set content_attributes = create_attribute() %}
{% endif %}
{% set content_attributes = content_attributes.addClass(['tab-content']) %}

{# Print the HTML. #}
<ul{{ attributes }}>
  {% if has_slot_content %}
    {{ items }}
  {% else %}
    <li class="nav-item"><a class="nav-link active" href="#">All</a></li>
    <li class="nav-item"><a class="nav-link" href="#">Architecture</a></li>
    <li class="nav-item"><a class="nav-link" href="#">Fashion</a></li>
  {% endif %}
</ul>

{% if has_panes_content %}
  <div{{ content_attributes }}>
    {{ panes }}
  </div>
{% endif %}
