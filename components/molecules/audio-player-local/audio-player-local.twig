{#
/**
 * @file
 * Vartheme BS5 Rightup Starter Kit implementation for the Local Audio Player component.
 *
 * Available properties:
 * - audio_url: A locally uploaded audio file's stream wrapper URI (e.g.
 *              `public://audio/episode.mp3`) — upload one directly via the
 *              Audio file field; resolved to a browser-accessible URL with
 *              Twig's `file_url()` before use. Leave empty to render
 *              nothing (e.g. while a file hasn't been set yet). Defaults to
 *              `''`.
 * - title: Optional label shown above the controls. Leave empty to omit.
 *          Defaults to `''`.
 * - autoplay: (true|false) Start playing automatically once loaded.
 *             Defaults to `false`.
 * - loop: (true|false) Restart playback automatically at the end. Defaults
 *         to `false`.
 * - preload: How much audio the browser should fetch upfront.
 *            (metadata | auto | none) Defaults to `metadata`.
 * - show_skip: (true|false) Show the skip-back / skip-forward buttons.
 *              Defaults to `true`.
 * - skip_seconds: Seconds the skip buttons jump. ('5' | '10' | '15' | '30')
 *                 Defaults to `'15'`.
 * - show_time: (true|false) Show the elapsed / total time. Defaults to
 *              `true`.
 * - show_download: (true|false) Show a download button for the audio file.
 *                   Defaults to `false`.
 * - accent_color: Bootstrap theme color for the play/pause button and the
 *                 seek bar's filled portion. (default | black | secondary
 *                  | primary | tertiary | accent | success | danger
 *                  | warning | info | light | dark | white) Defaults to
 *                 `default` (accent mint).
 *
 * Available attributes:
 * - attributes: HTML attributes for the containing element.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set audio_url = audio_url|default('') %}
{% set title = title|default('') %}
{% set preload = preload|default('metadata') %}
{% set skip_seconds = skip_seconds|default('15') %}
{% set accent_color = accent_color|default('default') %}

{# Logic: the uploaded file's `audio_url` prop is a stream wrapper URI
 # (e.g. `public://audio/episode.mp3`), not a browser-accessible URL —
 # resolve it with Twig's `file_url()` (wraps core's file_url_generator)
 # before using it anywhere. Skipped when empty: `file_url('')` still
 # returns `/`, which would wrongly satisfy `has_src` below.
 #}
{% if audio_url is not empty %}
  {% set audio_url = file_url(audio_url) %}
{% endif %}

{# Logic: resolve state flags. #}
{% set has_src = audio_url|trim is not empty %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set autoplay = autoplay ?? false %}
{% set loop = loop ?? false %}
{% set show_skip = show_skip ?? true %}
{% set show_time = show_time ?? true %}
{% set show_download = show_download ?? false %}

{# Logic: accent color modifier class — see audio-player-local.scss for the
 # `--audio-player-local-accent-*` custom property this sets.
 #}
{% set accent_classes = accent_color != 'default' ? ['audio-player-local--accent-' ~ accent_color] : [] %}

{# Logic: merge classes as arrays. #}
{% set classes = ['audio-player-local']|merge(accent_classes) %}
{% set attributes = attributes
  .addClass(classes)
  .setAttribute('data-skip-seconds', skip_seconds)
%}

{% set audio_attributes = create_attribute({
  'class': ['audio-player-local__media', 'visually-hidden'],
  'preload': preload,
  'src': audio_url,
}) %}
{% if autoplay %}
  {% set audio_attributes = audio_attributes.setAttribute('autoplay', 'autoplay') %}
{% endif %}
{% if loop %}
  {% set audio_attributes = audio_attributes.setAttribute('loop', 'loop') %}
{% endif %}

{# Print the HTML. #}
{% if has_src %}
  <div{{ attributes }}>
    <audio{{ audio_attributes }}></audio>

    {% if title|trim is not empty %}
      <p class="audio-player-local__title">{{ title }}</p>
    {% endif %}

    <div class="audio-player-local__controls">
      <div class="audio-player-local__buttons">
        {% if show_skip %}
          <button type="button" class="audio-player-local__button audio-player-local__button--skip-back" aria-label="{{ 'Skip back'|t }}">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
          </button>
        {% endif %}

        <button type="button" class="audio-player-local__button audio-player-local__button--toggle" aria-label="{{ 'Play'|t }}">
          <i class="bi bi-play-fill audio-player-local__icon audio-player-local__icon--play" aria-hidden="true"></i>
          <i class="bi bi-pause-fill audio-player-local__icon audio-player-local__icon--pause d-none" aria-hidden="true"></i>
        </button>

        {% if show_skip %}
          <button type="button" class="audio-player-local__button audio-player-local__button--skip-forward" aria-label="{{ 'Skip forward'|t }}">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
          </button>
        {% endif %}
      </div>

      <div class="audio-player-local__scrubber">
        {% if show_time %}
          <span class="audio-player-local__time-current" aria-hidden="true">0:00</span>
        {% endif %}

        <input
          type="range"
          class="audio-player-local__seek"
          min="0"
          max="100"
          value="0"
          step="0.1"
          aria-label="{{ 'Seek'|t }}"
        >

        {% if show_time %}
          <span class="audio-player-local__time-duration" aria-hidden="true">0:00</span>
        {% endif %}
      </div>

      {% if show_download %}
        <a href="{{ audio_url }}" download class="audio-player-local__button audio-player-local__button--download" aria-label="{{ 'Download audio'|t }}">
          <i class="bi bi-download" aria-hidden="true"></i>
        </a>
      {% endif %}
    </div>
  </div>
{% else %}
  {# Hidden on the live page; shown only in Drupal Canvas via the
   # `.is-canvas-preview` body class (see audio-player-local.scss and
   # vartheme_bs5_rightup_preprocess_html()) so an unconfigured instance
   # stays visible/selectable while editing instead of disappearing.
   #}
  <div{{ attributes.addClass(['audio-player-local--empty']) }}>
    <p class="audio-player-local__placeholder">{{ 'Local Audio Player — upload an audio file to preview playback.'|t }}</p>
  </div>
{% endif %}
